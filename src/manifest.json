{
  "manifest_version": 3,
  "name": "Wishdrop for Ønskeskyen",
  "version": "1.0.0",
  "description": "Drop the product you are looking at into your Ønskeskyen wishlist. One click, nothing stored. Unofficial.",
  "author": "Michael Brandt",
  "homepage_url": "https://github.com/hearmyego/onskeskyen-wishdrop",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Tilføj til Ønskeskyen",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": ["https://onskeskyen.dk/*quick-add*"],
      "js": ["quick-add-close.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wishdrop@hearmyego.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "short_name": "Wishdrop"
}
