{
  "manifest_version": 3,
  "name": "Wishdrop for Ønskeskyen",
  "version": "0.3.0",
  "description": "Drop the product you are looking at straight into your Ønskeskyen wishlist. One click, nothing stored.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["activeTab"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Tilføj til Ønskeskyen",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": ["https://onskeskyen.dk/*quick-add*"],
      "js": ["quick-add-close.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wishdrop@hearmyego.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "short_name": "Wishdrop"
}
