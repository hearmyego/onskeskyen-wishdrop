{
  "manifest_version": 3,
  "name": "Ønskeskyen Quick Add",
  "version": "0.1.0",
  "description": "Add the product page you're viewing to your Ønskeskyen wishlist with one click.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["activeTab"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Tilføj til Ønskeskyen",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "onskeskyen-quick-add@zen-plug",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
