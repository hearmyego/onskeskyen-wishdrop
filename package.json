{
  "name": "onskeskyen-wishdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Wishdrop: Firefox extension that drops the current product page into your Ønskeskyen wishlist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hearmyego/onskeskyen-wishdrop.git"
  },
  "type": "module",
  "scripts": {
    "dev": "web-ext run --source-dir src --start-url https://www.elgiganten.dk",
    "validate": "vp check && web-ext lint --source-dir src",
    "test": "vp test run",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest --filename onskeskyen-wishdrop-{version}.zip",
    "prepare": "vp config",
    "icons": "node scripts/icons.js",
    "release": "web-ext sign --source-dir src --artifacts-dir dist --channel listed --amo-metadata amo-metadata.json",
    "sign:unlisted": "web-ext sign --source-dir src --artifacts-dir dist --channel unlisted"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "vite-plus": "catalog:",
    "web-ext": "^10.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
