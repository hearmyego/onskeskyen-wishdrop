{
  "name": "zen-plug",
  "version": "0.1.0",
  "private": true,
  "description": "Zen Browser extension: add the current product page to Ønskeskyen",
  "type": "module",
  "scripts": {
    "dev": "web-ext run --source-dir src --firefox=${ZEN_BIN:-/Applications/Zen.app/Contents/MacOS/zen} --start-url https://www.elkjop.no",
    "validate": "vp check && web-ext lint --source-dir src",
    "test": "vp test run",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest --filename onskeskyen-quick-add-{version}.zip",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:",
    "web-ext": "^10.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
